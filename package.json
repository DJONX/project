{
  "name": "cameroon-merchants-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo skeleton for Cameroon Merchants Platform",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 && node scripts/verify-imports.mjs",
    "verify-imports": "node scripts/verify-imports.mjs",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.1.7",
    "zod": "^3.24.2"
  },
  "packageManager": "pnpm@10.30.3"
}
